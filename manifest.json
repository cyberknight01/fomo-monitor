{
  "manifest_version": 3,
  "name": "FOMO Monitor · API-first",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "后台 API 持仓与关注者监控；数量、成交证据和 Telegram 告警。",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://prod-api.fomo.family/*",
    "https://fomo.family/*",
    "https://api.telegram.org/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "FOMO Monitor",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://fomo.family/*"
      ],
      "js": [
        "src/session-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://fomo.family/*"
      ],
      "js": [
        "src/session-observer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "version_name": "V0.1"
}